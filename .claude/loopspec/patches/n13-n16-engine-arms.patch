+                    for (size_t k = b; k < e; ++k) drop[cyl[k]] = 1;
+                    if (std::getenv("STL2STEP_N5F_AXCOH") != nullptr)
+                        std::fprintf(stderr,
+                                     "N5F_TORUS drop n=%zu R=%.4f L2/L1=%.4f L3/L1=%.4f\n",
+                                     n, work.accepted[cyl[b]].radius, l2, l3);
+                }
+
+                // n12 P109 (env-gated): the same disease with a NON-PLANAR spine.
+                // A rolling fillet or blend has no primitive here either, so it ships
+                // as equal-radius cylinder patches -- but its axes follow the edge it
+                // runs along, so they are ISOTROPIC, not coplanar, and the n5f test
+                // above cannot see them. Measured on L09_valve_body: 123 cylinder
+                // faces on 121 distinct axis-lines, all at R=2.0, where the source
+                // CAD has 18 faces at that radius and 24 non-analytic ones.
+                // L3/L1 = 0.2045 (n5f needs < 0.05), 51 distinct axis directions,
+                // median face area 1.40 mm2 against a largest of 113.1 -- ten faces
+                // carry the real bores, the rest are slivers off the blend. Adopting
+                // that component costs -4.68 CADScore on its own, the worst in the
+                // corpus, which is why the refit volume gate rejects it.
+                //
+                // Signature: a big equal-radius group, axes spread in 3D, and a
+                // median member far smaller than the largest. Checked against every
+                // radius group of >=6 the live engine ships (7 groups over 103
+                // models, 5 of them matching truth): fires on none of them.
+                static const bool p109Blend =
+                    std::getenv("STL2STEP_N12_BLEND") != nullptr;
+                if (p109Blend && l3 > kIso) {
+                    double amax = 0;
+                    std::vector<double> ar;
+                    ar.reserve(n);
+                    for (size_t k = b; k < e; ++k) {
+                        double a = 0;
+                        for (int t : work.accepted[cyl[k]].tris) {
+                            const int* tv = mv.tris[mv.compTris[t]];
+                            const gp_XYZ& p0 = mv.pts[tv[0]];
+                            const gp_XYZ& p1 = mv.pts[tv[1]];
+                            const gp_XYZ& p2 = mv.pts[tv[2]];
+                            a += 0.5 * (p1 - p0).Crossed(p2 - p0).Modulus();
+                        }
+                        ar.push_back(a);
+                        amax = std::max(amax, a);
+                    }
+                    std::vector<double> srt = ar;
+                    std::sort(srt.begin(), srt.end());
+                    const double med = srt[srt.size() / 2];
+                    if (amax > 0.0 && med / amax < kSliver) {
+                        // Drop the whole group. Culling per member instead -- keeping
+                        // the 14 largest of valve_body's 123 -- was tried and MEASURED:
+                        // the component reverts again, so those 14 are blend patches
+                        // too, not bores. Wholesale is both simpler and the only one
+                        // that lets the component adopt.
+                        size_t nd = n;
+                        for (size_t k = b; k < e; ++k) drop[cyl[k]] = 1;
+                        if (std::getenv("STL2STEP_N5F_AXCOH") != nullptr)
+                            std::fprintf(stderr,
+                                         "N12_BLEND group n=%zu R=%.4f L3/L1=%.4f "
+                                         "med/max=%.4f dropped=%zu kept=%zu\n",
+                                         n, work.accepted[cyl[b]].radius, l3,
+                                         med / amax, nd, n - nd);
+                    }
+                }
+            }
+        }
+        b = e;
+    }
+
+    std::vector<Region> keep;
+    keep.reserve(work.accepted.size());
+    for (size_t i = 0; i < work.accepted.size(); ++i) {
+        if (!drop[i]) {
+            keep.push_back(work.accepted[i]);
+            continue;
+        }
+        // Hand the facets back so a later stage, not a hole, covers them.
+        for (int t : work.accepted[i].tris)
+            for (Provisional& pv : work.provisionals)
+                if (std::find(pv.tris.begin(), pv.tris.end(), t) != pv.tris.end()) {
+                    pv.claim = ProvClaim::Unclaimed;
+                    break;
+                }
+    }
+    work.accepted.swap(keep);
+    return true;
+}
