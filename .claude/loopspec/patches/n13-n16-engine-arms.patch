+// n16: the volume t4 SHOULD be measuring.
+//
+// `probe` is a raw BRep_Builder shell over the face list. BRepGProp integrates the
+// SIGNED contribution of each face using its stored orientation flag, so a shell
+// whose flags are internally mixed returns a number that is not the volume it
+// encloses -- while BRep_Tool::IsClosed (edge incidence only) and BRepCheck_Analyzer
+// both still pass. Measured on Mesh2step_test01: probe Gauss sum 132545.8, but the
+// same faces written to STEP and re-read enclose 135793.1, which is 0.011 % off the
+// mesh. t4 was rejecting a component for 3261.7 mm3 of bookkeeping, not geometry.
+//
+// Fix: orient the shell the way the shipping path already does (the same infinite-
+// point classifier `orientedSolid` uses), then take the magnitude. This is not a
+// widened tolerance -- the budget is untouched. It makes the gate measure the solid
+// that will actually be written.
+double orientedShapeVolume(const TopoDS_Shape& probe) {
+    double v = shapeVolume(probe);
+    if (probe.IsNull() || probe.ShapeType() != TopAbs_SHELL) return v;
+    try {
+        // A whole-shell Reversed() only NEGATES the Gauss sum, so taking its
+        // magnitude is a no-op -- measured. A mixed orientation field has to be
+        // repaired per face, which is what ShapeFix_Shell does.
+        TopoDS_Shape fixed = probe;
+        {
+            ShapeFix_Shell sfs(TopoDS::Shell(probe));
+            sfs.FixFaceOrientation(TopoDS::Shell(probe));
+            const TopoDS_Shell r = sfs.Shell();
+            if (!r.IsNull()) fixed = r;
+        }
+        BRep_Builder ob;
+        TopoDS_Solid so;
+        ob.MakeSolid(so);
+        ob.Add(so, TopoDS::Shell(fixed));
+        BRepClass3d_SolidClassifier cl(so);
+        cl.PerformInfinitePoint(Precision::Confusion());
+        if (cl.State() == TopAbs_IN) {
+            TopoDS_Solid so2;
+            ob.MakeSolid(so2);
+            ob.Add(so2, TopoDS::Shell(fixed.Reversed()));
+            so = so2;
+        }
+        const double ov = shapeVolume(so);
+        if (std::isfinite(ov)) v = std::fabs(ov);
+    } catch (const Standard_Failure&) {
+    }
+    return v;
+}
