+// n15 ARC-FIRST CLAIM. The seed path asks a pair of facet bands to fold by enough
+// to pin an axis; on 8 corpus models nothing is ever claimed at any seed floor
+// (measured: STL2STEP_P94_THETA_CYL_LO down to 0.5 deg changes 0/0 to 0/0), while
+// the arcs on those same meshes give the truth radii exactly. So take the axis from
+// the BOUNDARY instead of from the surface.
+//
+// Tommaso's three conditions, which are the reference's equal-step law applied to a
+// polyline: a run of boundary segments is an arc iff it is (1) coplanar,
+// (2) equal-chord, (3) equal-turn. The radius then follows by inversion,
+// R = w / (2 sin(t/2)) -- no circle fit, and far better conditioned on a short arc.
+// The run's plane normal IS the cylinder axis.
+//
+// This stage only proposes an axis. evaluateCommit still decides, so every B1 gate
+// applies unchanged, and the stage runs ONLY on provisionals nothing else claimed.
+namespace {
+
+struct ArcRun {
+    gp_Dir axis;
+    gp_XYZ ctr;           // arc centre: with the axis this is the axis LINE
+    double radius = 0;
+    double turn = 0;      // total turn, radians -- the arc's angular coverage
+    int npts = 0;
+};
+
+double cvOf(const std::vector<double>& xs) {
+    if (xs.size() < 2) return 0.0;
+    double m = 0.0;
+    for (double x : xs) m += x;
+    m /= (double)xs.size();
+    if (std::fabs(m) < 1e-12) return 1e9;
+    double v = 0.0;
+    for (double x : xs) v += (x - m) * (x - m);
+    return std::sqrt(v / (double)xs.size()) / std::fabs(m);
+}
+
+// Sharp-edge chains over the WHOLE component. Per-provisional boundaries do not
+// work: at a fine tessellation a bore wall is split into many 2-triangle
+// provisionals, so no single provisional owns a rim arc -- which is the same
+// reason the seed path fails on these models.
+void sharpChains(const MeshView& mv, const DerivedTols& tol,
+                 std::vector<std::vector<int>>& chainsOut) {
+    std::vector<int> t0(mv.nEdge, -1), t1(mv.nEdge, -1);
+    for (size_t lt = 0; lt < mv.nTri; lt++)
+        for (int k = 0; k < 3; k++) {
+            const int e = mv.triEdges[lt][k];
+            if (e < 0 || (size_t)e >= mv.nEdge) continue;
+            if (t0[e] < 0) t0[e] = (int)lt; else if (t1[e] < 0) t1[e] = (int)lt;
+        }
+    const double lim = std::cos(tol.thetaSharp);
+    std::vector<std::vector<int>> adj(mv.nVtx);
+    std::vector<char> isSharp(mv.nEdge, 0);
+    for (size_t e = 0; e < mv.nEdge; e++) {
+        if (t0[e] < 0) continue;
+        bool sharp = (t1[e] < 0);
+        if (!sharp) {
+            const gp_Dir a = triNormalLocal(mv, t0[e]), b = triNormalLocal(mv, t1[e]);
+            sharp = (a.Dot(b) < lim);
+        }
+        if (!sharp) continue;
+        isSharp[e] = 1;
+        const std::pair<int, int>& v = mv.compEdges[e];
+        adj[v.first].push_back(v.second);
+        adj[v.second].push_back(v.first);
+    }
+    std::set<std::pair<int, int>> used;
+    auto key = [](int a, int b) { return std::make_pair(std::min(a, b), std::max(a, b)); };
+    auto walk = [&](int a, int b) {
+        std::vector<int> ch{a, b};
+        used.insert(key(a, b));
+        while (true) {
+            const int cur = ch.back(), prev = ch[ch.size() - 2];
+            if ((size_t)cur >= adj.size() || adj[cur].size() != 2) break;
+            const int nxt = (adj[cur][0] == prev) ? adj[cur][1] : adj[cur][0];
+            if (used.count(key(cur, nxt))) break;
+            used.insert(key(cur, nxt));
+            ch.push_back(nxt);
+            if (nxt == ch.front()) break;
+        }
+        if (ch.size() >= 5) chainsOut.push_back(ch);
+    };
+    for (size_t e = 0; e < mv.nEdge; e++) {       // junctions and ends first
+        if (!isSharp[e]) continue;
+        const std::pair<int, int>& v = mv.compEdges[e];
+        for (int pass = 0; pass < 2; pass++) {
+            const int a = pass ? v.second : v.first, b = pass ? v.first : v.second;
+            if ((size_t)a < adj.size() && adj[a].size() != 2 && !used.count(key(a, b)))
+                walk(a, b);
+        }
+    }
+    for (size_t e = 0; e < mv.nEdge; e++) {       // then the closed rings
+        if (!isSharp[e]) continue;
+        const std::pair<int, int>& v = mv.compEdges[e];
+        if (!used.count(key(v.first, v.second))) walk(v.first, v.second);
+    }
+}
+
+// The three conditions on one chain. Returns the longest qualifying run.
+bool bestArcRun(const MeshView& mv, const std::vector<int>& ch, const DerivedTols& tol,
+                ArcRun& out) {
+    const size_t n = ch.size();
+    if (n < 5) return false;
+    std::vector<gp_XYZ> P(n);
+    for (size_t i = 0; i < n; i++) P[i] = mv.pts[mv.compVtx[ch[i]]];
+    std::vector<gp_XYZ> seg(n - 1);
+    std::vector<double> w(n - 1);
+    for (size_t i = 0; i + 1 < n; i++) {
+        seg[i] = P[i + 1] - P[i];
+        w[i] = seg[i].Modulus();
+    }
+    std::vector<double> t(n >= 3 ? n - 2 : 0);
+    std::vector<gp_XYZ> nm(t.size());
+    for (size_t i = 0; i + 1 < seg.size(); i++) {
+        const double a = w[i], b = w[i + 1];
+        if (a < 1e-12 || b < 1e-12) { t[i] = 0.0; nm[i] = gp_XYZ(0, 0, 0); continue; }
+        double c = seg[i].Dot(seg[i + 1]) / (a * b);
+        c = std::max(-1.0, std::min(1.0, c));
+        t[i] = std::acos(c);
+        const gp_XYZ x = seg[i].Crossed(seg[i + 1]);
+        const double xm = x.Modulus();
+        nm[i] = (xm > 1e-18) ? gp_XYZ(x / xm) : gp_XYZ(0, 0, 0);
+    }
+    const double kTurnMin = 2.0 * M_PI / 180.0;   // below this the run is straight
+    const double kCvW = 0.02, kCvT = 0.05, kCoplanar = 0.02;
+    bool found = false;
+    size_t i = 0;
+    while (i < t.size()) {
+        if (t[i] < kTurnMin) { i++; continue; }
+        size_t j = i;
+        while (j + 1 < t.size()) {
+            if (t[j + 1] < kTurnMin) break;
+            std::vector<double> ws(w.begin() + i, w.begin() + std::min(w.size(), j + 3));
+            std::vector<double> ts(t.begin() + i, t.begin() + (j + 2));
+            if (cvOf(ws) > kCvW || cvOf(ts) > kCvT) break;
+            gp_XYZ acc(0, 0, 0);
+            for (size_t k = i; k <= j + 1; k++) acc += nm[k];
+            const double am = acc.Modulus();
+            if (am < 1e-12) break;
+            const gp_XYZ u = acc / am;
+            bool flat = true;
+            for (size_t k = i; k <= j + 1; k++)
+                if (nm[k].Modulus() > 0.5 && std::fabs(nm[k].Dot(u)) < 1.0 - kCoplanar)
+                    flat = false;
+            if (!flat) break;
+            j++;
+        }
+        const size_t npts = j - i + 3;
+        if (npts >= 5) {
+            double mw = 0.0, mt = 0.0;
+            size_t cw = 0, ct = 0;
+            for (size_t k = i; k < std::min(w.size(), j + 2); k++) { mw += w[k]; cw++; }
+            for (size_t k = i; k <= j; k++) { mt += t[k]; ct++; }
+            if (cw && ct) {
+                mw /= (double)cw;
+                mt /= (double)ct;
+                gp_XYZ acc(0, 0, 0);
+                for (size_t k = i; k <= j; k++) acc += nm[k];
+                const double am = acc.Modulus();
+                if (mt > kTurnMin && am > 1e-12) {
+                    const double r = mw / (2.0 * std::sin(mt / 2.0));
+                    const double turn = mt * (double)(npts - 1);
+                    // Centre: every vertex sits at r*cos(t/2) from the centre along
+                    // the inward bisector of its two chords. Average over the run.
+                    gp_XYZ cacc(0, 0, 0);
+                    int ccnt = 0;
+                    for (size_t k = i + 1; k + 1 < i + npts && k + 1 < n; k++) {
+                        gp_XYZ a = P[k - 1] - P[k], b = P[k + 1] - P[k];
+                        const double am2 = a.Modulus(), bm2 = b.Modulus();
+                        if (am2 < 1e-12 || bm2 < 1e-12) continue;
+                        gp_XYZ bis = a / am2 + b / bm2;
+                        const double bm = bis.Modulus();
+                        if (bm < 1e-12) continue;
+                        cacc += P[k] + (bis / bm) * (r * std::cos(mt / 2.0));
+                        ccnt++;
+                    }
+                    if (ccnt && r > std::max(tol.epsMesh, 1e-4) && turn > out.turn) {
+                        out.axis = gp_Dir(acc / am);
+                        out.ctr = cacc / (double)ccnt;
+                        out.radius = r;
+                        out.turn = turn;
+                        out.npts = (int)npts;
+                        found = true;
+                    }
+                }
+            }
+        }
+        i = j + 1;
+    }
+    return found;
+}
