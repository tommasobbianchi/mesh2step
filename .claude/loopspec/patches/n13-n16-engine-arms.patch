+// n5f P100: the shoelace area of a face's outer wire in the face's OWN UV
+// parameterisation -- the quantity BRepCheck's OrientationOfWires judges. A
+// sampled 3D area (wireSignedAreaInPlane) is a proxy for it and can disagree
+// on a sliver. Returns 0.0 when any pcurve is missing.
+double n5fUvSignedArea(const TopoDS_Face& f, int& nEdgesOut, int& nMissingPc) {
+    nEdgesOut = 0;
+    nMissingPc = 0;
+    TopExp_Explorer we(f, TopAbs_WIRE);
+    if (!we.More()) return 0.0;
+    const TopoDS_Wire w = TopoDS::Wire(we.Current());
+    double acc = 0.0;
+    for (BRepTools_WireExplorer ex(w, f); ex.More(); ex.Next()) {
+        const TopoDS_Edge e = ex.Current();
+        ++nEdgesOut;
+        double a = 0.0, b = 0.0;
+        Handle(Geom2d_Curve) pc = BRep_Tool::CurveOnSurface(e, f, a, b);
+        if (pc.IsNull()) { ++nMissingPc; continue; }
+        const bool rev = (e.Orientation() == TopAbs_REVERSED);
+        const int kN = 8;
+        gp_Pnt2d prev;
+        for (int i = 0; i <= kN; ++i) {
+            const double t = rev ? b + (a - b) * (double)i / kN
+                                 : a + (b - a) * (double)i / kN;
+            const gp_Pnt2d q = pc->Value(t);
+            if (i > 0) acc += prev.X() * q.Y() - q.X() * prev.Y();
+            prev = q;
+        }
+    }
+    return 0.5 * acc;
+}
