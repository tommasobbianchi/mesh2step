+bool claimArcBandsN15(const MeshView& mv, const SegmentParams&, const DerivedTols& tol,
+                      SegmentWork& work) {
+    static const bool on = std::getenv("STL2STEP_N15_ARCS") != nullptr;
+    if (!on) return true;
+    // Risk discipline: act only where the component has NO analytic cylinder at all.
+    // Those are the measured detection-gap models. A component that already claimed
+    // cylinders has a RETENTION problem, which this stage does not address and must
+    // not perturb.
+    const bool diag = std::getenv("STL2STEP_N15_DIAG") != nullptr;
+    {
+        size_t nc = 0;
+        for (const Region& r : work.accepted)
+            if (r.type == SurfType::Cylinder) nc++;
+        if (diag)
+            std::fprintf(stderr, "N15_ARC entry accepted=%zu cylinders=%zu provs=%zu\n",
+                         work.accepted.size(), nc, work.provisionals.size());
+        if (nc) return true;
+    }
+    std::vector<std::vector<int>> chs;
+    sharpChains(mv, tol, chs);
+    std::vector<ArcRun> cands;
+    for (const std::vector<int>& ch : chs) {
+        ArcRun a;
+        if (bestArcRun(mv, ch, tol, a)) cands.push_back(a);
+    }
+    if (diag)
+        std::fprintf(stderr, "N15_ARC chains=%zu arcs=%zu\n", chs.size(), cands.size());
+    if (cands.empty()) return true;
+    // widest arc first: the best-pinned axis gets first claim on the triangles
+    std::sort(cands.begin(), cands.end(),
+              [](const ArcRun& a, const ArcRun& b) { return a.turn > b.turn; });
+
+    for (const ArcRun& a : cands) {
+        const gp_XYZ ad(a.axis.X(), a.axis.Y(), a.axis.Z());
+        const double band = std::max({epsCylRing(tol, a.radius), tol.epsMesh, 1e-4});
+        // A provisional joins only if ALL of its triangles lie on the cylinder: the
+        // claim model is whole-provisional (B1's invariant), and a partial absorb
+        // would leave A3 committing a plane over the same triangles.
+        std::vector<int> members, tris;
+        for (size_t pi = 0; pi < work.provisionals.size(); pi++) {
+            const Provisional& prov = work.provisionals[pi];
+            if (prov.claim != ProvClaim::Unclaimed || prov.tris.empty()) continue;
+            bool all = true;
+            for (int lt : prov.tris) {
+                for (int k = 0; k < 3 && all; k++) {
+                    const gp_XYZ q = localTriVert(mv, lt, k) - a.ctr;
+                    const double rr = ad.Crossed(q).Modulus();
+                    if (std::fabs(rr - a.radius) > band) all = false;
+                }
+                if (!all) break;
+            }
+            if (!all) continue;
+            members.push_back((int)pi);
+            tris.insert(tris.end(), prov.tris.begin(), prov.tris.end());
+        }
+        if (tris.size() < 2) continue;
+        std::sort(tris.begin(), tris.end());
+        // EDGE-CONNECTEDNESS. The radius test is geometric and will happily gather
+        // two bores that share a radius on opposite sides of the part, or a ring of
+        // facets that is not one surface. A region must be one edge-connected patch:
+        // measured on Mesh2step_test01, a disconnected R=16.686 claim built, closed
+        // and passed BRepCheck, then left its 210 triangles as an ISLAND -- the shell
+        // came out 3261.7 mm3 short against a 31.5 budget and t4 reverted the whole
+        // component, losing all four cylinders. Keep the largest connected patch only.
+        {
+            std::unordered_map<int, std::vector<int>> byEdge;
+            for (int lt : tris)
+                for (int k = 0; k < 3; k++) byEdge[mv.triEdges[lt][k]].push_back(lt);
+            std::unordered_map<int, int> comp;
+            int nComp = 0;
+            for (int seed : tris) {
+                if (comp.count(seed)) continue;
+                const int cid = nComp++;
+                std::vector<int> stack{seed};
+                comp[seed] = cid;
+                while (!stack.empty()) {
+                    const int cur = stack.back();
+                    stack.pop_back();
+                    for (int k = 0; k < 3; k++) {
+                        auto it = byEdge.find(mv.triEdges[cur][k]);
+                        if (it == byEdge.end()) continue;
+                        for (int nb : it->second)
+                            if (!comp.count(nb)) { comp[nb] = cid; stack.push_back(nb); }
+                    }
+                }
+            }
+            if (nComp > 1) {
+                std::vector<int> sz((size_t)nComp, 0);
+                for (const auto& kv : comp) sz[(size_t)kv.second]++;
+                const int keep =
+                    (int)(std::max_element(sz.begin(), sz.end()) - sz.begin());
+                std::vector<int> kt;
+                for (int lt : tris)
+                    if (comp[lt] == keep) kt.push_back(lt);
+                // members must stay whole-provisional: drop any provisional not
+                // entirely inside the kept patch.
+                std::vector<int> km;
+                const std::set<int> ks(kt.begin(), kt.end());
+                for (int m : members) {
+                    bool all = true;
+                    for (int lt : work.provisionals[(size_t)m].tris)
+                        if (!ks.count(lt)) { all = false; break; }
+                    if (all) km.push_back(m);
+                }
+                if (diag)
+                    std::fprintf(stderr,
+                                 "N15_ARC split R=%.5f comps=%d tris %zu->%zu provs %zu->%zu\n",
+                                 a.radius, nComp, tris.size(), kt.size(), members.size(),
+                                 km.size());
+                tris.swap(kt);
+                members.swap(km);
+                if (tris.size() < 2 || members.empty()) continue;
+            }
+        }
+        CommitEval ev = evaluateCommit(mv, tol, tris, a.axis, a.radius);
+        if (diag)
+            std::fprintf(stderr,
+                         "N15_ARC cand R=%.5f turn=%.1fdeg npts=%d provs=%zu tris=%zu "
+                         "evR=%.5f gate=%s\n",
+                         a.radius, a.turn * 180.0 / M_PI, a.npts, members.size(),
+                         tris.size(), ev.radius,
+                         ev.failGate == Gate::PASS ? "PASS" : "fail");
+        if (ev.failGate != Gate::PASS) continue;
+        Region reg;
+        fillCylinderRegion(mv, ev, a.axis, tris, reg);
+        work.accepted.push_back(reg);
+        for (int m : members) {
+            work.provisionals[m].claim = ProvClaim::ConsumedCylinder;
+            work.provisionals[m].tris.clear();
+            work.provisionals[m].area = 0.0;
+        }
+    }
+    return true;
+}
