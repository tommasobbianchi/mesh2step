+        std::fprintf(stderr, "N26_BLANKET_HELD candidates=%zu cyls=%d alreadyExploded=%d\n",
+                     all.size(), countAnalyticCylinders(rs), countExplodedCylinders(rs, exploded));
+    return wipe;
+}
