+bool rejectLowCoverageN18(const MeshView&, SegmentWork& work) {
+    const char* e = std::getenv("STL2STEP_N18_ARCCOV");
+    if (e == nullptr) return true;
+    double minDeg = std::atof(e);
+    if (!(minDeg > 0.0)) minDeg = 29.0;
+    const bool diag = std::getenv("STL2STEP_N18_DIAG") != nullptr;
+    std::vector<Region> keep;
+    keep.reserve(work.accepted.size());
+    size_t dropped = 0;
+    for (Region& r : work.accepted) {
+        if (r.type != SurfType::Cylinder || r.closed360) { keep.push_back(r); continue; }
+        const double covDeg = std::fabs(r.uMax - r.uMin) * 180.0 / M_PI;
+        if (covDeg >= minDeg) { keep.push_back(r); continue; }
+        if (diag)
+            std::fprintf(stderr, "N18_ARCCOV drop R=%.4f cov=%.2fdeg nTri=%zu\n",
+                         r.radius, covDeg, r.tris.size());
+        r.reject = Reject::Span;
+        work.rejected.push_back(r);
+        dropped++;
+    }
+    if (diag)
+        std::fprintf(stderr, "N18_ARCCOV kept=%zu dropped=%zu minDeg=%.1f\n",
+                     keep.size(), dropped, minDeg);
+    work.accepted.swap(keep);
+    return true;
+}
