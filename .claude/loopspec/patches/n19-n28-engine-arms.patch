+    static const bool on = std::getenv("STL2STEP_N26_NO_BLANKET") != nullptr;
+    if (!on) return false;
+    std::vector<int> all;
+    for (const Region& r : rs.regions)
+        if (!regionExploded(exploded, r.id)) all.push_back(r.id);
+    if (all.empty()) return false;
