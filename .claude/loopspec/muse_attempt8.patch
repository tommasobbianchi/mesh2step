+def _resample_cover(P, polys, am, grid=0.3):
+    """Well-shaped replacement triangles covering a sliver region whose scan facets sew invalid: grid-cluster its
+    vertices (border fidelity stays within sewing tolerance, so neighbours keep their own borders), Delaunay in the
+    best-fit plane, keep the inside ones. Returns (new_points, triples) or None. Delaunay maximises the minimum
+    angle, so the hairline slivers whose endpoints sewing merges into backtracking zero-area wires are gone."""
+    from scipy.spatial import Delaunay
+    if len(polys) < 1:
+        return None
+    key = np.floor(P / grid + 0.5).astype(np.int64)
+    _, idx = np.unique(key, axis=0, return_index=True)
+    Q = P[np.sort(idx)]
+    if len(Q) < 4:
+        return None
+    C = Q.mean(0)
+    _, _, Vt = np.linalg.svd(Q - C, full_matrices=False)
+    X = (Q - C) @ Vt[:2].T
+    try:
+        tri = Delaunay(X)
+    except Exception:                                  # noqa: BLE001 - degenerate point set
+        return None
+    polys2 = [(np.asarray(pp) - C) @ Vt[:2].T for pp in polys]
+
+    def a2(p):
+        return abs(0.5 * float(p[:, 0] @ np.roll(p[:, 1], -1) - p[:, 1] @ np.roll(p[:, 0], -1)))
+
+    outer = max(range(len(polys2)), key=lambda k: a2(polys2[k]))
+    holes = [polys2[k] for k in range(len(polys2)) if k != outer]
+    keep = [s for s in tri.simplices if _pip(X[s].mean(0), polys2[outer]) and not any(_pip(X[s].mean(0), h) for h in holes)]
+    if not keep:
+        return None
+    T = Q[np.array(keep)]
+    if abs(float(0.5 * np.linalg.norm(np.cross(T[:, 1] - T[:, 0], T[:, 2] - T[:, 0]), axis=1).sum()) - am) / max(am, 1e-12) > 0.25:
+        return None                                    # same 25 % budget as the analytic faces
+    e = np.linalg.norm(T - np.roll(T, -1, axis=1), axis=2)
+    e2 = e * e
+    cosg = np.stack([(e2[:, i] + e2[:, (i + 1) % 3] - e2[:, (i + 2) % 3]) / (2 * e[:, i] * e[:, (i + 1) % 3] + 1e-300)
+                     for i in range(3)], 1)
+    if float(np.arccos(np.clip(cosg, -1, 1)).min()) < np.radians(10):
+        return None                                    # still slivers: keep the original triangles
+    return Q, np.array(keep)
+
