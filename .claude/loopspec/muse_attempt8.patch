+def _pip(pt, poly):
+    """Point-in-polygon (ray casting) for one 2D loop."""
+    x, y = float(pt[0]), float(pt[1])
+    inside = False
+    n = len(poly)
+    for i in range(n):
+        x1, y1 = poly[i]
+        x2, y2 = poly[(i + 1) % n]
+        if ((y1 > y) != (y2 > y)) and (x < (x2 - x1) * (y - y1) / (y2 - y1 + 1e-300) + x1):
+            inside = not inside
+    return inside
+
