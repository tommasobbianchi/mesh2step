+def _split_cylinder_loop_at_seam(lp, V, s):
+    """Split a cylinder loop that crosses the seam into two loops at the seam."""
+    a = np.array(s["a"]) / np.linalg.norm(s["a"]); o = np.array(s["o"])
+    P = V[lp]
+    q = P - o
+    h = q @ a
+    radial = q - np.outer(h, a)
+    theta = np.arctan2(radial[:, 1], radial[:, 0])
+    # Find seam crossing: where theta jumps by > pi
+    dtheta = np.diff(theta)
+    seam_idx = np.where(np.abs(dtheta) > np.pi)[0]
+    if len(seam_idx) == 0:
+        return [lp]  # no seam crossing
+    # Split at seam crossings
+    result = []
+    start = 0
+    for idx in seam_idx:
+        result.append(lp[start:idx+1])
+        start = idx + 1
+    result.append(lp[start:])
+    # Filter out too-short segments
+    result = [seg for seg in result if len(seg) > 2]
+    return result if len(result) > 1 else [lp]
+
