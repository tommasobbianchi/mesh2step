refs/
*.step
*.stp
__pycache__/
*.egg-info/
.pytest_cache/
/tmp/
.gitnexus
/build/

# The parity oracle: golden solids from the stl2step reference engine. These are
# the specification for v2 and must be versioned, unlike ordinary .step output.
!tests/data/reference/*.step

# local editor/tooling state, not project content
.claude/settings.local.json
.claude/settings.local.json*.bak

# Executor/agent worktrees: production reads builder scripts straight from this tree,
# so an agent editing a file here serves a half-written file. Agents work in .worktrees/<slug>.
.worktrees/
