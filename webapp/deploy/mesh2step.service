[Unit]
Description=mesh2step web app (uvicorn on :8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/mesh2step
ExecStart=/usr/bin/python3 -m uvicorn webapp.server:app --host 0.0.0.0 --port 8000 --log-level warning
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
